      "label": {
        "de": "Aufbewahrungsfristen"
      },
      "summary": {
        "de": "Schülerbögen 10 Jahre nach Abgang (Gy/RS), Zeugnisduplikate/Abschlussverzeichnisse 50 Jahre"
      },
      "source": "Aufbewahrungsverordnung Schulen"
    },
    {
      "id": "privatschulen",
      "kind": "private-school",
      "label": {
        "de": "Genehmigte vs. anerkannte Ersatzschulen"
      },
      "summary": {
        "de": "Waldorfschulen sind in Bayern in der Regel genehmigte, nicht anerkannte Ersatzschulen – daher keine eigene Prüfungsberechtigung und Abschlüsse extern."
      },
      "source": "BayEUG Art. 92, 100"
    }
  ]
