  "rules": [
    {
      "id": "uebertritt-sek1",
      "kind": "transition",
      "label": {
        "de": "Übertrittsverfahren Primarstufe → Sekundarstufe I"
      },
      "applies_to": {
        "from_grade": "h8",
        "to_program": "sek1"
      },
      "mode": "recommendation-with-probation",
      "summary": {
        "de": "In der 6. Klasse: Beurteilung durch die Lehrpersonen, Übertrittsgespräch mit den Eltern, Zuweisung zum Real- oder Sekundarschulniveau je Niveaufach (Deutsch, Französisch, Mathematik) und zum Schultyp. Bei Uneinigkeit zwischen Schule und Eltern entscheidet eine kantonale Kontrollprüfung. Die Zuteilung wird auf jede Promotion hin überprüft (durchlässig)."
      },
      "source": "VSG Art. 33 ff.; DVBS Art. 32–46",
      "url": "https://www.akvb-unterricht.bkd.be.ch/de/start/unterricht/beurteilung-uebertritte.html"
    },
    {
      "id": "aufnahme-gym",
      "kind": "admission",
      "label": {
        "de": "Aufnahme in den gymnasialen Bildungsgang (GYM1)"
      },
      "applies_to": {
        "to_program": "gym"
      },
      "mode": "recommendation-or-exam",
      "summary": {
        "de": "Eintritt in GYM1 aus dem 8. oder 9. Schuljahr. Weg 1: Empfehlung der abgebenden Schule (Sekundarschulniveau in allen Niveaufächern, Beurteilung der überfachlichen Kompetenzen). Weg 2: kantonale Aufnahmeprüfung in Deutsch, Französisch, Mathematik – mit zwei Prüfungsserien je nach Vorbildung (8. bzw. 9. Schuljahr). Die Qualifikation gilt nur für den nächstmöglichen Eintritt. Eintritt in GYM3 nur unter besonderen Bedingungen."
      },
      "source": "MiSG; Mittelschulverordnung MiSV; Aufnahmeverfahren Gymnasium BKD",
      "url": "https://www.bkd.be.ch/de/start/themen/bildung-im-kanton-bern/mittelschulen/gymnasium/aufnahmeverfahren-gymnasium.html"
    },
    {
      "id": "aufnahme-fms",
      "kind": "admission",
      "label": {
        "de": "Aufnahme in die Fachmittelschule"
      },
      "applies_to": {
        "to_program": "fms"
      },
      "mode": "recommendation-or-exam",
      "summary": {
        "de": "Aus dem 9. Schuljahr mit Empfehlung der abgebenden Schule oder kantonaler Aufnahmeprüfung."
      },
      "source": "MiSG; MiSV"
    },
    {
      "id": "schulpflicht",
      "kind": "compulsory-schooling",
      "label": {
        "de": "Obligatorische Schulzeit"
      },
      "summary": {
        "de": "11 Jahre: 2 Jahre Kindergarten (oder Basisstufe) und 9 Jahre Volksschule. Eintritt in den Kindergarten für Kinder, die bis 31. Juli das 4. Altersjahr vollendet haben."
      },
      "source": "VSG Art. 22 ff."
    },
    {
      "id": "niveauwechsel",
      "kind": "promotion",
      "label": {
        "de": "Wechsel von Niveau und Schultyp"
      },
      "applies_to": {
        "programs": [
          "sek1"
        ]
      },
      "mode": "per-promotion",
      "summary": {
        "de": "Auf Empfehlung der Lehrpersonen kann die Zuteilung in den Niveaufächern oder des Schultyps per Schullaufbahnentscheid auf die nächste Promotion (Semesterende) hin geändert werden – in beide Richtungen."
      },
      "source": "DVBS; Weisungen Zusammenarbeitsformen Sek I"
    }
  ],
