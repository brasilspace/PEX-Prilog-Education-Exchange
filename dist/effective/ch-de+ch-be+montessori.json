  "rules": [
    {
      "id": "uebertritt-sek1",
      "kind": "transition",
      "label": {
        "de": "Übertrittsverfahren Primarstufe → Sekundarstufe I",
        "en": "Transfer procedure primary → lower secondary"
      },
      "applies_to": {
        "from_grade": "h8",
        "to_program": "sek1"
      },
      "mode": "recommendation-with-probation",
      "summary": {
        "de": "In der 6. Klasse: Beurteilung durch die Lehrpersonen, Übertrittsgespräch mit den Eltern, Zuweisung zum Real- oder Sekundarschulniveau je Niveaufach (Deutsch, Französisch, Mathematik) und zum Schultyp. Bei Uneinigkeit zwischen Schule und Eltern entscheidet eine kantonale Kontrollprüfung. Die Zuteilung wird auf jede Promotion hin überprüft (durchlässig).",
        "en": "In grade 6: assessment by the teachers, transfer meeting with the parents, assignment to the Real or Sek level per level subject (German, French, mathematics) and to the school type. If school and parents disagree, a cantonal control examination decides. The assignment is reviewed at every promotion (permeable)."
      },
      "source": "VSG Art. 33 ff.; DVBS Art. 32–46",
      "url": "https://www.akvb-unterricht.bkd.be.ch/de/start/unterricht/beurteilung-uebertritte.html"
    },
    {
      "id": "aufnahme-gym",
      "kind": "admission",
      "label": {
        "de": "Aufnahme in den gymnasialen Bildungsgang (GYM1)",
        "en": "Admission to the gymnasium programme (GYM1)"
      },
      "applies_to": {
        "to_program": "gym"
      },
      "mode": "recommendation-or-exam",
      "summary": {
