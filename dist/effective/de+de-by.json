  "rules": [
    {
      "id": "uebertritt-5",
      "kind": "transition",
      "label": {
        "de": "Übertritt nach Jahrgangsstufe 4"
      },
      "applies_to": {
        "from_grade": "g4"
      },
      "mode": "binding-recommendation",
      "summary": {
        "de": "Übertrittszeugnis im Mai: Gymnasium bei Notenschnitt bis 2,33 in Deutsch, Mathematik und HSU; Realschule bis 2,66; sonst Probeunterricht an der aufnehmenden Schule (3 Tage). Bei Nichtbestehen kann der Elternwille nur bei mindestens 4/4 im Probeunterricht durchgreifen."
      },
      "source": "BayEUG Art. 44; GrSO §§ 6–8; RSO § 2; GSO § 2"
    },
    {
      "id": "schulpflicht",
      "kind": "compulsory-schooling",
      "label": {
        "de": "Schulpflicht"
      },
      "summary": {
        "de": "9 Jahre Vollzeitschulpflicht, danach 3 Jahre Berufsschulpflicht; Einschulungskorridor: Stichtag 30. Juni, Kinder mit Geburtstag Juli–September nach Elternentscheidung."
      },
      "source": "BayEUG Art. 35–37"
    },
    {
      "id": "m-zug",
