  "rules": [
    {
      "id": "uebertritt-5",
      "kind": "transition",
      "label": {
        "de": "Übergang nach Klasse 4"
      },
      "applies_to": {
        "from_grade": "g4"
      },
      "mode": "parent-choice",
      "summary": {
        "de": "Eltern wählen zwischen Stadtteilschule und Gymnasium; die Grundschule gibt eine Einschätzung ab, die nicht bindend ist. Am Gymnasium entscheidet die Beobachtungsstufe (Jg. 5–6) über den Verbleib."
      },
      "source": "HmbSG § 42, APO-GrundStGy § 8"
    },
    {
      "id": "schulpflicht",
      "kind": "compulsory-schooling",
      "label": {
        "de": "Schulpflicht"
      },
      "summary": {
        "de": "11 Jahre Vollzeitschulpflicht (inkl. Vorschule) oder bis zum Ende des Schuljahres, in dem das 18. Lebensjahr vollendet wird; Einschulungsstichtag 1. Juli."
      },
      "source": "HmbSG §§ 37–39"
    },
    {
      "id": "lernentwicklungsgespraech",
      "kind": "attendance",
      "label": {
        "de": "Lernentwicklungsgespräche"
      },
      "summary": {
        "de": "Einmal pro Halbjahr verpflichtendes Gespräch Lehrkraft–Schüler–Eltern mit Lernvereinbarung, ersetzt teilweise den klassischen Elternsprechtag."
      },
      "source": "HmbSG § 44 Abs. 3; Zeugnisordnung"
    }
  ],
  "exams": [
    {
      "id": "abitur-hh",
      "label": {
        "de": "Abiturprüfung Hamburg"
      },
      "qualification": "abitur",
      "mode": "central",
      "at_grade": "g12",
