          "label": {
            "de": "Präsentationsprüfung"
          }
        }
      ],
      "summary": {
        "de": "Zentrale schriftliche Prüfungen in den Kernfächern; Präsentationsprüfung als 5. Komponente."
      },
      "source": "APO-AH §§ 20–26"
    },
    {
      "id": "abitur-waldorf-hh",
      "label": {
        "de": "Abitur an anerkannten Ersatzschulen"
      },
      "qualification": "abitur",
      "mode": "state-recognized",
      "at_grade": "g13",
      "summary": {
        "de": "Anerkannte Ersatzschulen (u. a. Waldorf) führen die Abiturprüfung selbst durch, mit zentralen Aufgaben und staatlichem Prüfungsvorsitz; keine Schulfremdenprüfung."
      },
      "source": "HmbSG § 113; APO-AH"
    },
    {
      "id": "msa-hh",
      "label": {
        "de": "Prüfung zum Mittleren Schulabschluss"
      },
      "qualification": "msa",
      "mode": "central",
      "at_grade": "g10",
      "components": [
        {
          "id": "written",
          "count": 3
        },
        {
          "id": "oral",
          "count": 1
        }
      ],
      "source": "APO-GrundStGy §§ 22 ff."
    }
  ],
